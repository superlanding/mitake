# frozen_string_literal: true

source 'https://rubygems.org'

gemspec path: '..'

gem 'bundler', '~> 2.0'
gem 'bundler-audit', '~> 0.9.0'
gem 'overcommit', '~> 0.60.0'
gem 'rake', '~> 13.0'
gem 'rspec', '~> 3.0'
gem 'rubocop', '~> 1.50.0'

# Ruby 3.4: stdlib default gem; needed by rubocop stack
gem 'base64', '>= 0.2'
